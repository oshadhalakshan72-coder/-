{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Store inventory products",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "inStock": { "type": "boolean" },
        "stockCount": { "type": "number" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "isFlashSale": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "sku": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "warranty": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "customerPhone": { "type": "string" },
        "shippingAddress": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "trackingNumber": { "type": "string" }
      },
      "required": ["customerName", "customerPhone", "items", "total"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and preferences",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "storeTagline": { "type": "string" },
        "ownerWhatsAppNumber": { "type": "string" },
        "supportEmail": { "type": "string" },
        "currency": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered customer profiles",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "role": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of products available in the store"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Placed customer orders"
    },
    "/settings/{settingsId}": {
      "schema": "StoreSettings",
      "description": "Store configuration document"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer and admin user profiles"
    }
  }
}
